# JANGAN COMMIT FILE INI KE GIT
# Isi DEV_PRIVATE_KEY dengan private key dev wallet (0xa16E9579E19eB19e6E24B211121BdCD7996809Cc)
# Private key TANPA prefix 0x atau DENGAN prefix 0x — keduanya bisa, ethers.js handle otomatis

DEV_PRIVATE_KEY=

# RPC endpoint (default: bsc-dataseed1.binance.org)
RPC_URL=https://bsc-dataseed1.binance.org/

# Interval sync dalam menit (default: 15)
SYNC_INTERVAL_MIN=15

# Lookback blocks untuk first run / fallback (default: 5000 ~ 4-5 jam)
LOOKBACK_BLOCKS=5000
